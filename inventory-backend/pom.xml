<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.example.inventory</groupId>
  <artifactId>inventory-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>inventory-backend</name>
  <description>Multi-tenant inventory management platform — backend</description>

  <properties>
    <!-- The Boot 4.1 parent defaults java.version to 17. This must be set
         explicitly or the build silently targets the wrong release. -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Connection used by the flyway-maven-plugin only (`./mvnw flyway:info`),
         never by the application. These are the same local-only defaults as
         docker-compose.yml, and each is overridable: -Dflyway.url=... etc.
         Migrations always run as the schema owner, never as the app role. -->
    <flyway.url>jdbc:postgresql://localhost:5432/inventory</flyway.url>
    <flyway.user>inventory_owner</flyway.user>
    <flyway.password>local_dev_only</flyway.password>

    <!-- ===================================================================
         THE single source of truth for the application role's password.

         This literal must not appear anywhere else. Two independent Flyway
         configurations consume it, and if they ever disagree, V2 creates
         inventory_app with one password while the application connects with
         another:

           1. flyway-maven-plugin  <placeholders> below      (the CLI path)
           2. Spring's Flyway      application-local.yml     (the app path)

         application-local.yml reads it as @app.db.password@, which the Boot
         parent's resource filtering substitutes at build time — so the two
         cannot drift.

         Overriding, in increasing precedence:
           default below
           DB_APP_PASSWORD environment variable  (see the profile at the end
             of this file; Spring reads the same variable directly at runtime)
           -Dapp.db.password=...  on the Maven command line

         Local-only value. Production supplies DB_APP_PASSWORD and never
         reaches this default — application-prod.yml has no fallback.
         =================================================================== -->
    <app.db.password>app_local_only</app.db.password>

    <!-- ===================================================================
         THE single source of truth for the login role's password.

         Same contract as <app.db.password> above, for the inventory_login role
         created by V3: one literal, consumed by both Flyway configurations
         (the <placeholders> below and spring.flyway.placeholders.* in
         application-local.yml, which reads it as @app.login.password@).

         A separate password from the app role's on purpose. They are separate
         roles with separate privileges, and sharing one secret would mean a
         leak of either is a leak of both.

         Overriding, in increasing precedence:
           default below
           DB_LOGIN_PASSWORD environment variable (see the profile at the end
             of this file; Spring reads the same variable directly)
           -Dapp.login.password=...  on the Maven command line
         =================================================================== -->
    <app.login.password>login_local_only</app.login.password>

    <!-- Not in the Boot 4.1 BOM, so it has to be pinned. Reads OpenAPI 3.1. -->
    <swagger-parser.version>2.1.22</swagger-parser.version>

    <jacoco.version>0.8.15</jacoco.version>
    <!-- M0 has no business logic, so any non-zero gate is either vacuous or an
         instant failure. The plugin is wired now so M1 only has to raise this. -->
    <jacoco.line.coverage.minimum>0.00</jacoco.line.coverage.minimum>

    <!-- Every other version below comes from the Boot 4.1 BOM. Do not pin these
         by hand: Boot 4.1 manages Flyway 12.4.0, Testcontainers 2.0.5,
         Hibernate 7.4.1, JUnit Jupiter 6.0.3 and the PostgreSQL driver. -->
  </properties>

  <dependencies>
    <!-- ==================== Web / persistence / validation ================= -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- M1: added together with SecurityConfig, as the M0 note here promised.
         An unconfigured security starter would lock /actuator/health behind a
         generated password, so this and that configuration land in one change. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- JWT issue and verify. Chosen over jjwt because it is the Spring-native
         path: this brings spring-security-oauth2-jose (NimbusJwtEncoder /
         NimbusJwtDecoder) plus nimbus-jose-jwt, and integrates with the resource
         server filter chain rather than sitting beside it.

         "Resource server" is the right module even though this application also
         ISSUES the tokens it verifies. There is no separate authorisation
         server, and adding spring-authorization-server for a single HMAC key
         would be a great deal of machinery for no benefit. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Validates docs/openapi.yaml as part of the build (ApiContractTest).
         The contract is the source of truth (CLAUDE.md section 1), and it spent
         M0 and M1 silently unparseable while claiming to validate — a check that
         runs only when somebody remembers is the same as no check.

         Not managed by the Boot BOM, so the version is pinned here. Test scope:
         nothing at runtime reads the contract. -->
    <dependency>
      <groupId>io.swagger.parser.v3</groupId>
      <artifactId>swagger-parser</artifactId>
      <version>${swagger-parser.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ==================== Database ======================================= -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Boot 4 split auto-configuration out of spring-boot-autoconfigure into
         per-technology modules. org.flywaydb:flyway-core on its own gives you
         the library but NOT FlywayAutoConfiguration, so migrations never run
         and the failure is silent — the app just starts against an empty
         schema. This starter pulls flyway-core plus spring-boot-flyway. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Flyway 10+ moved per-database support into separate modules. Without
         this, Flyway cannot resolve a PostgreSQL dialect at runtime. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- ==================== Lombok ========================================= -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ==================== Test =========================================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers 2.x renamed its modules. These are NOT the 1.x
         coordinates: org.testcontainers:postgresql and :junit-jupiter do not
         exist at 2.0.5. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- No H2, at any scope. See CLAUDE.md T10: H2 has neither row-level
         security nor set_config, so it cannot test tenant isolation at all. -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Makes `./mvnw flyway:info` work, as documented in CLAUDE.md section 3.
           The plugin runs outside Spring, so it needs the PostgreSQL module and
           the driver on its own classpath — the application's dependencies are
           not visible to it. Version comes from the Boot parent. -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <configuration>
          <url>${flyway.url}</url>
          <user>${flyway.user}</user>
          <password>${flyway.password}</password>
          <locations>
            <location>filesystem:src/main/resources/db/migration</location>
          </locations>
          <!-- Must mirror spring.flyway.placeholders.* in application-local.yml.
               Without this, V2 fails to parse on an empty database with
               'No value provided for placeholder: ${appUserPassword}'. The
               failure is invisible until then: against an already-migrated
               database Flyway never re-parses V2, so flyway:migrate reports
               success and only a fresh volume exposes it. -->
          <placeholders>
            <appUserPassword>${app.db.password}</appUserPassword>
            <loginUserPassword>${app.login.password}</loginUserPassword>
          </placeholders>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
          </dependency>
          <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
          </dependency>
        </dependencies>
      </plugin>

      <!-- Coverage gate for `./mvnw verify`. Threshold is 0.00 for M0 on
           purpose; raise it in M1 when there is logic worth measuring. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Lets DB_APP_PASSWORD drive the Maven side too, so the CLI path and the
         Spring path honour the same environment variable. Spring reads it
         directly (${DB_APP_PASSWORD:...} in application-local.yml); Maven has no
         syntax for "environment variable with a default", hence this profile.
         Activates automatically whenever the variable is present. A
         -Dapp.db.password on the command line still wins over it. -->
    <profile>
      <id>app-db-password-from-env</id>
      <activation>
        <property>
          <name>env.DB_APP_PASSWORD</name>
        </property>
      </activation>
      <properties>
        <app.db.password>${env.DB_APP_PASSWORD}</app.db.password>
      </properties>
    </profile>

    <!-- The same arrangement for the V3 login role. A separate profile rather
         than a second property on the one above: the two variables are set
         independently, and bundling them would mean supplying DB_APP_PASSWORD
         alone silently left the login password at its local default. -->
    <profile>
      <id>login-db-password-from-env</id>
      <activation>
        <property>
          <name>env.DB_LOGIN_PASSWORD</name>
        </property>
      </activation>
      <properties>
        <app.login.password>${env.DB_LOGIN_PASSWORD}</app.login.password>
      </properties>
    </profile>
  </profiles>
</project>
