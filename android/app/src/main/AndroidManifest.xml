<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      No android:usesCleartextTraffic here, deliberately. The debug manifest
      overlays a network security config that permits cleartext for 10.0.2.2
      alone; release inherits the platform default, which forbids it outright.
      Putting it here would apply to both.
    -->
    <application
        android:name=".InventoryApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_agenda"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inventory">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Inventory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
